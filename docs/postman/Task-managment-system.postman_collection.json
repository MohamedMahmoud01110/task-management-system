        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const token = pm.response.json().data.token;\r",
                  "\r",
                  "pm.environment.set(\"token\", token);\r",
                  "\r",
                  "pm.test(\"Token is present in response\", function () {\r",
                  "    pm.expect(token).to.not.be.undefined;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
